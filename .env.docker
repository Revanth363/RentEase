# Docker Environment Variables
# Copy this file to .env and fill in actual values for production

# ===================================
# NODE ENVIRONMENT
# ===================================
NODE_ENV=production
PORT=5000

# ===================================
# DATABASE (MongoDB)
# ===================================
# Local Docker connection uses: mongodb://admin:admin123@mongodb:27017/rentease?authSource=admin
# For external MongoDB Atlas, use full connection string
MONGODB_URI=mongodb://admin:admin123@mongodb:27017/rentease?authSource=admin

# ===================================
# CACHE (Redis)
# ===================================
# Local Docker connection
REDIS_URL=redis://:redis123@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# ===================================
# AUTHENTICATION (JWT)
# ===================================
# Generate a strong 64+ character random string for production
JWT_SECRET=8b0ca85d7246f6611eb96d3789599ebf6a2a53651cda57ede50dd708d8f69fee

# ===================================
# CLIENT CONFIGURATION
# ===================================
CLIENT_URL=http://localhost

# ===================================
# PAYMENT GATEWAY (Razorpay)
# ===================================
RAZORPAY_KEY_ID=rzp_test_SXh62cAi73FbRI
RAZORPAY_KEY_SECRET=2nwSPTz0T6VLLKLm51UIxhL7

# ===================================
# FILE STORAGE (Cloudinary)
# ===================================
CLOUDINARY_CLOUD_NAME=dvmlpjt4j
CLOUDINARY_API_KEY=153766142949821
CLOUDINARY_API_SECRET=EOg4lgkVsvUppw02-9LFy7RXfls

# ===================================
# AUTHENTICATION (Google OAuth 2.0)
# ===================================
GOOGLE_CLIENT_ID=722798414628-d02foi4n9cng0doof82kqcpdf0d13tmv.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_CALLBACK_URL=http://localhost/auth/google/callback

# ===================================
# SEARCH ENGINE (Solr) - Optional
# ===================================
# If Solr is not available, backend will fallback to MongoDB
SOLR_HOST=solr
SOLR_PORT=8983
SOLR_CORE=rentease

# ===================================
# FRONTEND (Vite)
# ===================================
VITE_API_URL=http://backend:5000
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
